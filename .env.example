# Parenthèse, configuration de l'auto-hébergement (docker compose).
# Copiez ce fichier en .env et remplissez les deux valeurs marquées "à remplir".
# Le fichier .env est ignoré par git : vos secrets restent sur votre machine.
#
# NODE_ENV, PORT, DATABASE_URL et MEDIA_STORAGE_PATH sont fixés par docker-compose.yml,
# inutile de les définir ici.

# ── Base de données (conteneur db, non exposé hors du réseau Docker) ──────────
POSTGRES_USER=parenthese
POSTGRES_DB=parenthese
# À remplir. Lettres et chiffres uniquement : la valeur est insérée dans une URL de connexion.
# Fixé au premier démarrage : pour le changer ensuite il faut recréer le volume db-data.
POSTGRES_PASSWORD=

# ── API ───────────────────────────────────────────────────────────────────────
# À remplir, 32 caractères conseillés. Générer avec :
#   openssl rand -base64 48
#   ou : node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# L'API refuse de démarrer en production avec la valeur de développement.
JWT_SECRET=
# Durée de vie des sessions (compte) et des accès par lien partagé.
JWT_EXPIRES_IN=7d
JWT_TREE_ACCESS_EXPIRES_IN=24h
# Adresse à laquelle vos proches ouvrent Parenthèse, sans slash final.
# En local : http://localhost (ou http://localhost:8080 si WEB_PORT=8080).
# Derrière un reverse proxy HTTPS : https://arbre.votre-domaine.fr
# Plusieurs adresses : séparées par des virgules.
CORS_ORIGIN=http://localhost
# Proxys dont l'API croit l'en-tête X-Forwarded-For (adresse des visiteurs, limites d'essais).
# Par défaut, le nginx du conteneur web (réseau Docker privé). Si vous ajoutez un reverse proxy
# devant, ajoutez son adresse, par exemple loopback,uniquelocal,203.0.113.10
# TRUST_PROXY=loopback,uniquelocal
# Place disque par arbre (Mo), et part réservée aux envois de la famille en attente de relecture.
# MEDIA_QUOTA_PER_TREE_MB=5120
# MEDIA_PENDING_QUOTA_PER_TREE_MB=500

# ── Immich (reconnaissance des visages, désactivé par défaut) ────────────────
# Associer à chaque personne de l'arbre un visage reconnu par votre instance
# Immich (https://immich.app) ; sa vignette devient le portrait.
# IMMICH_ENABLED : true pour activer. IMMICH_API_URL : adresse de l'instance,
# sans slash final. IMMICH_API_KEY : clé créée dans Immich (Paramètres > Clés d'API).
# Sans ces trois valeurs, la fonction reste éteinte.
# IMMICH_ENABLED=true
# IMMICH_API_URL=http://immich.example.org:2283
# IMMICH_API_KEY=

# ── Images ────────────────────────────────────────────────────────────────────
# Version des images ghcr.io/iliesallali/parenthese-api et parenthese-web : latest (dernière
# version de main), ou une version figée, par exemple 1.0.
# PARENTHESE_VERSION=latest

# ── Web ───────────────────────────────────────────────────────────────────────
# Port publié sur la machine hôte (80 = http://localhost sans préciser de port).
WEB_PORT=80
