NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/genealogy"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
JWT_TREE_ACCESS_EXPIRES_IN="24h"
CORS_ORIGIN="http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176"
MEDIA_STORAGE_PATH="./storage/media"
# Reconnaissance des visages via une instance Immich (https://immich.app). Désactivé par défaut.
# IMMICH_API_URL : adresse de l'API, sans slash final. IMMICH_API_KEY : clé créée dans Immich.
IMMICH_ENABLED=false
IMMICH_API_URL="http://immich.example.org:2283"
IMMICH_API_KEY=""
